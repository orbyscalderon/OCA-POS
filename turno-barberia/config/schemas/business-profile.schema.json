{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocpos.app/schemas/business-profile.schema.json",
  "title": "OC POS · Manifiesto de Perfil de Negocio",
  "description": "Contrato del Engine de Nicho. Un manifiesto válido define por completo cómo se autoconfigura un tenant: base de datos sembrada, UI renderizada, roles, automatizaciones y reportes. Cambiar este esquema es cambiar el contrato de todos los nichos.",
  "type": "object",
  "required": ["profile", "modules", "operation_modes", "attributes", "ui", "roles"],
  "additionalProperties": false,

  "properties": {
    "$schema": { "type": "string" },

    "profile": {
      "type": "object",
      "required": ["slug", "name", "category", "version", "primary_mode"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$" },
        "name": { "type": "string", "minLength": 2 },
        "category": {
          "type": "string",
          "enum": ["retail", "servicios", "alimentos", "salud", "financiero", "agro", "industrial"]
        },
        "icon": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "primary_mode": { "$ref": "#/$defs/operationMode" },
        "description": { "type": "string" }
      }
    },

    "modules": {
      "type": "object",
      "description": "Feature flags con forma. Un módulo deshabilitado no expone rutas, endpoints ni permisos.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "required": { "type": "boolean" },
          "label": { "type": "string" }
        },
        "required": ["enabled"]
      }
    },

    "operation_modes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operationMode" }
    },

    "compliance": {
      "type": "object",
      "properties": {
        "age_verification": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "min_age": { "type": "integer", "minimum": 0 },
            "prompt": { "type": "string" },
            "blocking": { "type": "boolean" },
            "applies_to_categories": { "type": "array", "items": { "type": "string" } }
          }
        },
        "prescription_required": { "type": "object" }
      }
    },

    "uoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name", "dimension", "factor_to_base"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,15}$" },
          "name": { "type": "string" },
          "plural_name": { "type": "string" },
          "dimension": { "type": "string", "enum": ["unit", "weight", "volume", "length", "area", "time"] },
          "factor_to_base": { "type": "number", "exclusiveMinimum": 0 },
          "is_base": { "type": "boolean" },
          "precision": { "type": "integer", "minimum": 0, "maximum": 6 }
        }
      }
    },

    "uom_policy": {
      "type": "object",
      "properties": {
        "purchase_default": { "type": "string" },
        "consumption_default": { "type": "string" },
        "sale_defaults": { "type": "object", "additionalProperties": { "type": "string" } },
        "scale_integration": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "protocols": { "type": "array", "items": { "type": "string" } },
            "barcode_rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["prefix", "code_start", "code_len", "value_start", "value_len", "value_kind"],
                "properties": {
                  "prefix": { "type": "string" },
                  "code_start": { "type": "integer", "minimum": 1 },
                  "code_len": { "type": "integer", "minimum": 1 },
                  "value_start": { "type": "integer", "minimum": 1 },
                  "value_len": { "type": "integer", "minimum": 1 },
                  "value_kind": { "type": "string", "enum": ["price", "weight_kg", "weight_g", "units"] },
                  "value_decimals": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },

    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "name"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "parent": { "type": "string" },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "icon": { "type": "string" },
          "kind": { "type": "string", "enum": ["good", "service"] },
          "purchasable_only": { "type": "boolean" }
        }
      }
    },

    "attributes": {
      "type": "object",
      "description": "Atributos dinámicos agrupados por scope. Cada entrada se materializa como fila en app.attribute_definitions con source='profile'.",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/attributeDefinition" }
      },
      "propertyNames": {
        "enum": ["product", "variant", "inventory_lot", "customer", "supplier",
                 "biological_lot", "biological_daily", "service_order", "employee"]
      }
    },

    "product_defaults": {
      "type": "object",
      "description": "Valores por defecto de las banderas de comportamiento de app.products.",
      "properties": {
        "kind": { "type": "string", "enum": ["good", "service", "combo", "raw_material", "livestock", "fee"] },
        "track_inventory": { "type": "boolean" },
        "track_lots": { "type": "boolean" },
        "track_expiry": { "type": "boolean" },
        "track_serials": { "type": "boolean" },
        "is_weighted": { "type": "boolean" },
        "allow_negative_stock": { "type": "boolean" },
        "age_restricted": { "type": "boolean" },
        "requires_prescription": { "type": "boolean" },
        "is_sellable": { "type": "boolean" },
        "reorder_point": { "type": "number", "minimum": 0 }
      }
    },

    "agro": { "$ref": "#/$defs/agroConfig" },
    "appointments": { "type": "object" },

    "ui": {
      "type": "object",
      "required": ["navigation", "pos"],
      "properties": {
        "navigation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "label", "route"],
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "icon": { "type": "string" },
              "route": { "type": "string", "pattern": "^/" },
              "primary": { "type": "boolean" },
              "requires_module": { "type": "string" },
              "requires_permission": { "type": "string" }
            }
          }
        },
        "pos": {
          "type": "object",
          "required": ["layout"],
          "properties": {
            "layout": {
              "type": "string",
              "enum": ["grid_with_images", "weight_first", "service_first", "search_first", "tables"]
            },
            "primary_action": { "type": "string", "enum": ["scan", "scale", "search", "select_service", "select_table"] },
            "show_product_images": { "type": "boolean" },
            "show_stock_badge": { "type": "boolean" },
            "variant_selector": { "type": "string", "enum": ["none", "inline_list", "modal_matrix", "dropdown"] },
            "variant_axes": { "type": "array", "items": { "type": "string" } },
            "quick_filters": { "type": "array", "items": { "type": "string" } },
            "keypad": { "type": "string", "enum": ["numeric", "weight", "none"] },
            "allow_price_override": { "type": "boolean" },
            "price_override_permission": { "type": "string" },
            "require_customer": { "type": "boolean" },
            "require_employee_per_line": { "type": "boolean" },
            "allow_tip": { "type": "boolean" },
            "tip_presets": { "type": "array", "items": { "type": "number" } },
            "default_uom_selector": { "type": "boolean" }
          }
        },
        "product_form": {
          "type": "object",
          "properties": {
            "groups": { "type": "array", "items": { "type": "string" } },
            "hidden_fields": { "type": "array", "items": { "type": "string" } }
          }
        },
        "agro_daily_form": { "type": "object" },
        "dashboard_widgets": { "type": "array", "items": { "type": "string" } }
      }
    },

    "receipt": {
      "type": "object",
      "properties": {
        "width_mm": { "type": "integer", "enum": [58, 80] },
        "show_attributes": { "type": "array", "items": { "type": "string" } },
        "show_logo": { "type": "boolean" },
        "show_employee_name": { "type": "boolean" },
        "show_weight_detail": { "type": "boolean" },
        "show_lot_traceability": { "type": "boolean" },
        "show_qr_storefront": { "type": "boolean" },
        "footer": { "type": "string" }
      }
    },

    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "permissions"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,30}$" },
          "name": { "type": "string" },
          "permissions": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(\\*|[a-z_]+\\.(\\*|[a-z_]+))$" }
          },
          "constraints": {
            "type": "object",
            "properties": {
              "max_discount_pct": { "type": "number", "minimum": 0, "maximum": 100 },
              "can_sell_below_cost": { "type": "boolean" },
              "requires_supervisor_pin": { "type": "array", "items": { "type": "string" } },
              "scope": { "type": "string" },
              "shift_window": { "type": "object" }
            }
          }
        }
      }
    },

    "automations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "enabled"],
        "properties": {
          "key": { "type": "string" },
          "enabled": { "type": "boolean" },
          "config": { "type": "object" }
        }
      }
    },

    "reports": { "type": "array", "items": { "type": "string" } }
  },

  "$defs": {
    "operationMode": {
      "type": "string",
      "enum": ["quick_pos", "variant_inventory", "appointments", "lending", "tables", "biological_lots", "search_first"]
    },

    "attributeDefinition": {
      "type": "object",
      "required": ["key", "label", "data_type"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,40}$" },
        "label": { "type": "string" },
        "help_text": { "type": "string" },
        "data_type": {
          "type": "string",
          "enum": ["text", "number", "integer", "boolean", "date", "datetime",
                   "enum", "multi_enum", "money", "percent", "uuid_ref", "file"]
        },
        "ui_widget": {
          "type": "string",
          "enum": ["text", "textarea", "number", "stepper", "select", "segmented",
                   "chips", "toggle", "date_picker", "datetime_picker", "file_upload", "color"]
        },
        "ui_group": { "type": "string" },
        "unit_suffix": { "type": "string" },
        "ref_entity": {
          "type": "string",
          "description": "Requerido cuando data_type es uuid_ref.",
          "enum": ["employee", "farm_unit", "supplier", "customer", "warehouse", "category", "variant"]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string" },
              "label": { "type": "string" },
              "color": { "type": "string" }
            }
          }
        },
        "validation": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number" },
            "minLength": { "type": "integer" },
            "maxLength": { "type": "integer" },
            "regex": { "type": "string" },
            "unique": { "type": "boolean" }
          }
        },
        "default_value": {},
        "is_required": { "type": "boolean" },
        "is_variant_axis": { "type": "boolean" },
        "is_filterable": { "type": "boolean" },
        "show_in_pos": { "type": "boolean" },
        "show_in_receipt": { "type": "boolean" },
        "show_in_storefront": { "type": "boolean" },
        "semantic_role": {
          "type": "string",
          "description": "Activa comportamiento del kernel, no solo almacena un dato.",
          "enum": ["expiry", "batch", "serial", "weight", "volume", "potency", "origin", "warranty"]
        },
        "position": { "type": "integer", "minimum": 0 },
        "applies_to_categories": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "data_type": { "const": "uuid_ref" } }, "required": ["data_type"] },
          "then": { "required": ["ref_entity"] }
        },
        {
          "if": {
            "properties": { "data_type": { "enum": ["enum", "multi_enum"] } },
            "required": ["data_type"]
          },
          "then": { "required": ["options"] }
        },
        {
          "if": { "properties": { "is_variant_axis": { "const": true } } },
          "then": {
            "properties": { "data_type": { "enum": ["enum", "text", "integer", "number"] } }
          }
        }
      ]
    },

    "agroConfig": {
      "type": "object",
      "properties": {
        "lot_code_pattern": { "type": "string" },
        "cost_types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "label"],
            "properties": {
              "code": {
                "type": "string",
                "enum": ["livestock", "feed", "medicine", "supplies", "labor",
                         "utilities", "transport", "depreciation", "overhead", "other"]
              },
              "label": { "type": "string" },
              "capitalizable": { "type": "boolean" }
            }
          }
        },
        "daily_record_fields": { "type": "array", "items": { "type": "string" } },
        "death_causes": { "type": "array", "items": { "type": "string" } },
        "harvest": {
          "type": "object",
          "properties": {
            "kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["slaughter", "partial", "daily_yield", "milking",
                         "egg_collection", "crop_harvest", "weaning", "shearing"]
              }
            },
            "default_allocation": {
              "type": "string",
              "enum": ["by_weight", "by_market_value", "by_qty", "manual"]
            },
            "outputs_template": { "type": "array", "items": { "type": "object" } }
          }
        },
        "benchmarks": { "type": "object" },
        "health_schedule_template": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["day_offset", "task_type", "name"],
            "properties": {
              "day_offset": { "type": "integer" },
              "task_type": {
                "type": "string",
                "enum": ["vaccine", "medication", "feed_change", "weighing",
                         "cleaning", "inspection", "irrigation", "fertilization", "harvest"]
              },
              "name": { "type": "string" },
              "repeat_every_days": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "species": { "type": "array", "items": { "type": "string" } },
        "production_kinds": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
