// Esquema de datos de Turno
// PostgreSQL elegido por soporte robusto de transacciones, locks (SELECT ... FOR UPDATE)
// y constraints para garantizar la ausencia de dobles reservas y el límite de 5 peluqueros.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App (runtime): conexión pooled (Supabase PgBouncer, puerto 6543).
  url       = env("DATABASE_URL")
  // Migraciones: conexión directa (puerto 5432). En local es igual a DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Rol {
  superadmin
  admin_negocio
  peluquero
  cliente
}

enum EstadoSuscripcion {
  activo
  vencido
  prueba
}

enum EstadoAprobacion {
  pendiente
  aceptado
  rechazado
}

enum EstadoPago {
  pendiente
  pagado
  reembolsado
}

enum EstadoCita {
  confirmada
  cancelada
  no_asistio
  completada
}

enum DiaSemana {
  lunes
  martes
  miercoles
  jueves
  viernes
  sabado
  domingo
}

model Usuario {
  id                Int       @id @default(autoincrement())
  nombre            String    @db.VarChar(100)
  telefono          String    @db.VarChar(20)
  email             String    @unique @db.VarChar(150)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  rol               Rol
  fotoUrl           String?   @map("foto_url") @db.VarChar(255)
  emailVerificadoEn DateTime? @map("email_verificado_en")
  bloqueado         Boolean   @default(false) // baneo por el superadmin
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relaciones
  negociosPropios       Negocio[]                @relation("DuenoNegocio")
  membresias            PeluqueroEquipo[]
  membresiasNegocio     MiembroNegocio[]
  servicios             Servicio[]
  disponibilidades      Disponibilidad[]
  bloqueosAgenda        Bloqueo[]
  reservasComoCliente   Reservacion[]            @relation("ClienteReserva")
  reservasComoPeluquero Reservacion[]            @relation("PeluqueroReserva")
  tokensReset           PasswordResetToken[]
  tokensEmail           EmailVerificationToken[]
  refreshTokens         RefreshToken[]
  resenas               Resena[]

  @@map("usuarios")
}

model Negocio {
  id                     String            @id @default(cuid())
  nombreComercial        String            @map("nombre_comercial") @db.VarChar(150)
  slug                   String            @unique
  // Categoría del negocio (barbería, estética, spa, uñas, etc.). Plataforma multi-rubro.
  categoria              String            @default("barberia") @db.VarChar(40)
  // Rubro/perfil del motor de nicho (barberia, restaurante, supermercado…). Activa sus módulos.
  perfil                 String?           @db.VarChar(40)
  direccion              String            @db.Text
  telefonoContacto       String            @map("telefono_contacto") @db.VarChar(20)
  logoUrl                String?           @map("logo_url") @db.VarChar(255)
  coverUrl               String?           @map("cover_url") @db.VarChar(255)
  // PIN de acceso al panel de Contabilidad (gastos/impuestos/compras/analítica): separado del
  // login normal, así un cajero con sesión iniciada no puede ver los reportes financieros sin
  // que el dueño/gerente ingrese este PIN. Null = todavía no configurado (panel bloqueado).
  pinContabilidadHash    String?           @map("pin_contabilidad_hash") @db.VarChar(255)
  timezone               String            @default("America/Santo_Domingo") @db.VarChar(64)
  // Geolocalización para búsqueda por cercanía.
  lat                    Float?
  lng                    Float?
  // Reputación agregada (se recalcula al crear reseñas).
  ratingPromedio         Float             @default(0) @map("rating_promedio")
  ratingConteo           Int               @default(0) @map("rating_conteo")
  estadoSuscripcion      EstadoSuscripcion @default(prueba) @map("estado_suscripcion")
  plan                   String?           @db.VarChar(20) // basico | pro
  intervaloPlan          String?           @map("intervalo_plan") @db.VarChar(10) // mensual | anual
  suscripcionHasta       DateTime?         @map("suscripcion_hasta")
  // IDs de la pasarela para el cobro mensual del SaaS.
  stripeCustomerId       String?           @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId   String?           @map("stripe_subscription_id") @db.VarChar(255)
  // Stripe Connect: cuenta del negocio para recibir su parte de la fianza.
  stripeConnectAccountId String?           @map("stripe_connect_account_id") @db.VarChar(255)
  cobrosActivos          Boolean           @default(false) @map("cobros_activos") // onboarding completo
  payoutInterval         String?           @map("payout_interval") @db.VarChar(10) // daily|weekly|monthly (null = por defecto)
  payoutAnchor           Int?              @map("payout_anchor") // día del mes (monthly)
  duenoId                Int               @map("dueno_id")
  createdAt              DateTime          @default(now()) @map("created_at")

  // Fidelización (módulo loyalty): cuántos puntos otorga cada venta y cuántos hacen falta
  // para el premio (ej. "cada 10 recargas, la próxima gratis" = 1 punto por venta, 10 para el
  // premio). Se acumulan solos al cobrar una venta con cliente asociado.
  puntosPorVenta   Int @default(1) @map("puntos_por_venta")
  puntosParaPremio Int @default(10) @map("puntos_para_premio")

  dueno               Usuario             @relation("DuenoNegocio", fields: [duenoId], references: [id], onDelete: Cascade)
  equipo              PeluqueroEquipo[]
  miembros            MiembroNegocio[]
  invitaciones        InvitacionNegocio[]
  resenas             Resena[]
  prestamos           Prestamo[]
  productos           Producto[]
  perfilesDispositivo PerfilDispositivo[]
  ventas              Venta[]
  sesionesCaja        SesionCaja[]
  lotesAgro           LoteBiologico[]
  granjas             Granja[]
  mesas               Mesa[]
  comandas            Comanda[]
  ordenesServicio     OrdenServicio[]
  gastos              Gasto[]
  clientes            ClienteNegocio[]
  compras             Compra[]

  @@index([estadoSuscripcion])
  @@map("negocios")
}

// ============================================================
//  MÓDULO: COMPRAS (reposición de inventario desde proveedores)
// ============================================================
model Compra {
  id         String        @id @default(cuid())
  negocioId  String        @map("negocio_id")
  negocio    Negocio       @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  proveedor  String?       @db.VarChar(120)
  total      Decimal       @db.Decimal(12, 2)
  fecha      DateTime
  // "pendiente" = orden de compra guardada, todavía no sumó stock ni tocó el costo del
  // producto; "recibida" = ya entró al inventario (al crearla directo, o al recibir una
  // pendiente). Antes solo existía el registro inmediato — esto separa "pedí esto" de
  // "esto ya llegó", para poder guardar la orden y recibirla después.
  estado     String        @default("recibida") @db.VarChar(12)
  recibidaEn DateTime?     @map("recibida_en")
  createdAt  DateTime      @default(now()) @map("created_at")
  lineas     LineaCompra[]

  @@index([negocioId])
  @@map("compras")
}

model LineaCompra {
  id         String    @id @default(cuid())
  compraId   String    @map("compra_id")
  compra     Compra    @relation(fields: [compraId], references: [id], onDelete: Cascade)
  productoId String?   @map("producto_id")
  producto   Producto? @relation(fields: [productoId], references: [id])
  nombre     String    @db.VarChar(150)
  cantidad   Decimal   @db.Decimal(12, 3)
  costoUnit  Decimal   @map("costo_unit") @db.Decimal(12, 2)

  @@map("lineas_compra")
}

// ============================================================
//  MÓDULOS DE SOPORTE: GASTOS y CLIENTES (casi todos los rubros)
// ============================================================
model Gasto {
  id          String   @id @default(cuid())
  negocioId   String   @map("negocio_id")
  negocio     Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  categoria   String?  @db.VarChar(60)
  descripcion String   @db.VarChar(200)
  monto       Decimal  @db.Decimal(12, 2)
  fecha       DateTime
  createdAt   DateTime @default(now()) @map("created_at")

  // Costeo por lote biológico (agro): si se asigna, el gasto cuenta para el costo
  // de ese lote (alimento, sanidad, mano de obra…) y no solo para el gasto general.
  loteId    String?        @map("lote_id")
  lote      LoteBiologico? @relation(fields: [loteId], references: [id], onDelete: SetNull)
  tipoCosto String?        @map("tipo_costo") @db.VarChar(20) // livestock|feed|medicine|supplies|labor|utilities|transport|other

  // Gasto general de una granja o un galpón completo (luz, mantenimiento…) que no es de UN
  // lote en particular — no se prorratea entre lotes, es su propio total aparte.
  granjaId String? @map("granja_id")
  granja   Granja? @relation(fields: [granjaId], references: [id], onDelete: SetNull)
  galponId String? @map("galpon_id")
  galpon   Galpon? @relation(fields: [galponId], references: [id], onDelete: SetNull)

  @@index([negocioId])
  @@index([loteId])
  @@index([granjaId])
  @@index([galponId])
  @@map("gastos")
}

model ClienteNegocio {
  id         String   @id @default(cuid())
  negocioId  String   @map("negocio_id")
  negocio    Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  nombre     String   @db.VarChar(120)
  telefono   String?  @db.VarChar(20)
  email      String?  @db.VarChar(150)
  direccion  String?  @db.VarChar(200)
  notas      String?  @db.VarChar(300)
  // Fidelización: puntos/sellos acumulados (módulo loyalty).
  puntos     Int      @default(0)
  // Fiado / crédito abierto (módulo credit): cuánto le debe este cliente al negocio.
  saldoFiado Decimal  @default(0) @map("saldo_fiado") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  ventas Venta[]

  @@index([negocioId])
  @@map("clientes_negocio")
}

// ============================================================
//  MÓDULO: AGRO (granja avícola: lotes biológicos)
// ============================================================
// Jerarquía opcional Empresa (Negocio) > Granja > Galpón/Nave > Lote. Un lote puede seguir
// sin granja/galpón asignado (negocios chicos con un solo sitio no necesitan la jerarquía) —
// por eso LoteBiologico.galponId es nullable y no rompe los lotes que ya existían antes de esto.
model Granja {
  id        String   @id @default(cuid())
  negocioId String   @map("negocio_id")
  negocio   Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  nombre    String   @db.VarChar(120)
  direccion String?  @db.VarChar(200)
  notas     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  galpones Galpon[]
  gastos   Gasto[]

  @@index([negocioId])
  @@map("granjas")
}

model Galpon {
  id            String   @id @default(cuid())
  granjaId      String   @map("granja_id")
  granja        Granja   @relation(fields: [granjaId], references: [id], onDelete: Cascade)
  nombre        String   @db.VarChar(120)
  capacidadAves Int?     @map("capacidad_aves")
  notas         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  lotes  LoteBiologico[]
  gastos Gasto[]

  @@index([granjaId])
  @@map("galpones")
}

model LoteBiologico {
  id              String   @id @default(cuid())
  negocioId       String   @map("negocio_id")
  negocio         Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  // Ubicación opcional dentro de la jerarquía Granja > Galpón — null = lote "suelto", sigue
  // funcionando igual que antes de agregar esto.
  galponId        String?  @map("galpon_id")
  galpon          Galpon?  @relation(fields: [galponId], references: [id], onDelete: SetNull)
  nombre          String   @db.VarChar(120)
  especie         String   @default("broiler") @db.VarChar(20) // broiler | layer
  tipoProduccion  String   @default("meat") @map("tipo_produccion") @db.VarChar(20) // meat | eggs
  cantidadInicial Int      @map("cantidad_inicial")
  fechaInicio     DateTime @map("fecha_inicio")
  costoInicial    Decimal? @map("costo_inicial") @db.Decimal(12, 2)
  // Línea genética (cobb500, ross308, lohmann_brown…) — habilita comparar el lote contra la
  // curva estándar del proveedor (peso objetivo por edad, % de postura objetivo). Null = sin
  // comparativa, el lote sigue funcionando igual con solo sus propios indicadores reales.
  lineaGenetica   String?  @map("linea_genetica") @db.VarChar(30)
  estado          String   @default("activo") @db.VarChar(10) // activo | cerrado
  notas           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  registros         RegistroAgro[]
  gastos            Gasto[]
  productos         Producto[]
  eventosSanitarios EventoSanitario[]

  @@index([negocioId])
  @@index([galponId])
  @@map("lotes_biologicos")
}

model RegistroAgro {
  id            String        @id @default(cuid())
  loteId        String        @map("lote_id")
  lote          LoteBiologico @relation(fields: [loteId], references: [id], onDelete: Cascade)
  fecha         DateTime
  mortalidad    Int           @default(0)
  alimentoKg    Decimal       @default(0) @map("alimento_kg") @db.Decimal(12, 3)
  pesoPromedioG Decimal?      @map("peso_promedio_g") @db.Decimal(12, 3)
  produccion    Int           @default(0) // huevos u otra unidad producida ese día (total = suma de calibres si se cargaron)
  // Clasificación de huevos por calibre comercial (solo lotes de postura) — todo opcional,
  // si no se usa el registro sigue funcionando solo con "produccion" como antes.
  huevosJumbo   Int           @default(0) @map("huevos_jumbo")
  huevosExtra   Int           @default(0) @map("huevos_extra")
  huevosGrande  Int           @default(0) @map("huevos_grande")
  huevosMediano Int           @default(0) @map("huevos_mediano")
  huevosPequeno Int           @default(0) @map("huevos_pequeno")
  huevosRotos   Int           @default(0) @map("huevos_rotos")
  huevosSucios  Int           @default(0) @map("huevos_sucios")
  notas         String?       @db.VarChar(200)

  @@unique([loteId, fecha])
  @@index([loteId])
  @@map("registros_agro")
}

// Sanidad: vacunas, tratamientos y síntomas del lote. Algunos medicamentos exigen un
// "periodo de retiro" (días sin poder vender/sacrificar) — se guarda acá para poder
// avisar en el lote mientras ese periodo sigue activo.
model EventoSanitario {
  id         String        @id @default(cuid())
  loteId     String        @map("lote_id")
  lote       LoteBiologico @relation(fields: [loteId], references: [id], onDelete: Cascade)
  tipo       String        @db.VarChar(20) // vacuna | tratamiento | sintoma | otro
  nombre     String        @db.VarChar(120)
  fecha      DateTime
  diasRetiro Int?          @map("dias_retiro")
  notas      String?       @db.VarChar(300)
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([loteId])
  @@map("eventos_sanitarios")
}

// ============================================================
//  MÓDULO: MESAS / COMANDAS (restaurante)
// ============================================================
model Mesa {
  id        String    @id @default(cuid())
  negocioId String    @map("negocio_id")
  negocio   Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  nombre    String    @db.VarChar(40)
  estado    String    @default("libre") @db.VarChar(10) // libre | ocupada
  comandas  Comanda[]

  @@index([negocioId])
  @@map("mesas")
}

model Comanda {
  id        String         @id @default(cuid())
  negocioId String         @map("negocio_id")
  negocio   Negocio        @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  mesaId    String?        @map("mesa_id")
  mesa      Mesa?          @relation(fields: [mesaId], references: [id])
  estado    String         @default("abierta") @db.VarChar(10) // abierta | cerrada | cancelada
  total     Decimal        @default(0) @db.Decimal(12, 2)
  createdAt DateTime       @default(now()) @map("created_at")
  lineas    LineaComanda[]

  @@index([negocioId])
  @@map("comandas")
}

model LineaComanda {
  id         String  @id @default(cuid())
  comandaId  String  @map("comanda_id")
  comanda    Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  nombre     String  @db.VarChar(150)
  cantidad   Decimal @db.Decimal(12, 3)
  precioUnit Decimal @map("precio_unit") @db.Decimal(12, 2)
  notas      String? @db.VarChar(200)

  @@map("lineas_comanda")
}

// ============================================================
//  MÓDULO: ÓRDENES DE SERVICIO (taller / servicio técnico)
// ============================================================
model OrdenServicio {
  id              String   @id @default(cuid())
  negocioId       String   @map("negocio_id")
  negocio         Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  clienteNombre   String   @map("cliente_nombre") @db.VarChar(120)
  clienteTelefono String?  @map("cliente_telefono") @db.VarChar(20)
  equipo          String   @db.VarChar(200) // equipo o vehículo recibido
  problema        String?  @db.Text
  diagnostico     String?  @db.Text
  estado          String   @default("recibido") @db.VarChar(15) // recibido|diagnostico|reparacion|listo|entregado|cancelado
  costoEstimado   Decimal? @map("costo_estimado") @db.Decimal(12, 2)
  costoFinal      Decimal? @map("costo_final") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([negocioId])
  @@map("ordenes_servicio")
}

// ============================================================
//  MÓDULO: INVENTARIO + POS + CAJA (rubros de retail/alimentos)
// ============================================================
model Producto {
  id          String   @id @default(cuid())
  negocioId   String   @map("negocio_id")
  negocio     Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  nombre      String   @db.VarChar(150)
  imagenUrl   String?  @map("imagen_url") @db.VarChar(255)
  sku         String?  @db.VarChar(60) // código de barras / SKU
  categoria   String?  @db.VarChar(60)
  unidad      String   @default("UND") @db.VarChar(12)
  precioVenta Decimal  @map("precio_venta") @db.Decimal(12, 2)
  // % de impuesto (ITBIS/IVA). 0 = exento. Se aplica sobre el precio en la venta.
  impuestoPct Decimal  @default(0) @map("impuesto_pct") @db.Decimal(5, 2)
  costo       Decimal? @db.Decimal(12, 2)
  stock       Decimal  @default(0) @db.Decimal(12, 3)
  stockMinimo Decimal  @default(0) @map("stock_minimo") @db.Decimal(12, 3)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  // Agro: si el producto sale de un lote biológico (p. ej. "Pollo entero" del lote X),
  // sus ventas se suman como ingreso de ese lote para calcular el margen real.
  loteId String?        @map("lote_id")
  lote   LoteBiologico? @relation(fields: [loteId], references: [id], onDelete: SetNull)

  // Atributos de líquidos de vapeo (opcionales; solo aplican a ese tipo de producto).
  volumenMl  Decimal? @map("volumen_ml") @db.Decimal(8, 2)
  nicotinaMg Decimal? @map("nicotina_mg") @db.Decimal(6, 2)

  // Trazabilidad de lote/vencimiento (farmacia, panadería y cualquier perecedero). Opcional —
  // un producto sin fecha simplemente no entra en la alerta de "por vencer".
  loteNumero       String?   @map("lote_numero") @db.VarChar(60)
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Date

  // Hardware (dispositivos, se vende una vez) vs consumible (líquidos/resistencias, el
  // cliente vuelve a comprar seguido) — separa el inventario para poder mirarlos aparte.
  tipoProducto  String  @default("consumible") @map("tipo_producto") @db.VarChar(20)
  // Asesoría técnica para el personal al vender (ej. "sales de nicotina: solo con pods
  // pequeños, no en atomizadores grandes") — se muestra en el mostrador al agregarlo al carrito.
  notasTecnicas String? @map("notas_tecnicas") @db.Text

  // Si este producto es un SERVICIO que se sirve consumiendo stock de OTRO producto (p. ej.
  // "Recarga" descuenta ml del pote "Líquido Mango 30ml"), en vez de llevar stock propio.
  // rendimientoPorVenta = cuánto se descuenta del producto fuente por cada unidad vendida de
  // ESTE producto (p. ej. 3 = 3ml por recarga vendida), para que el cálculo de lo que queda
  // en el pote sea correcto sin tener que llevar dos inventarios separados a mano.
  productoFuenteId    String?    @map("producto_fuente_id")
  productoFuente      Producto?  @relation("ProductoFuente", fields: [productoFuenteId], references: [id], onDelete: SetNull)
  rendimientoPorVenta Decimal?   @map("rendimiento_por_venta") @db.Decimal(8, 3)
  recargas            Producto[] @relation("ProductoFuente")

  // Sabores de una misma línea (ej. "Recargas" con variantes Mango/Fresa/Menta): cada sabor
  // sigue siendo su propio Producto, con su propio stock/costo/precio (se descuentan
  // independientemente al vender) — esto solo los agrupa para poder agregarlos rápido desde
  // uno ya creado y para que buscar el nombre de la línea encuentre todos sus sabores.
  varianteBaseId String?    @map("variante_base_id")
  varianteBase   Producto?  @relation("VariantesSabor", fields: [varianteBaseId], references: [id], onDelete: SetNull)
  sabores        Producto[] @relation("VariantesSabor")

  movimientos  MovimientoStock[]
  lineasVenta  LineaVenta[]
  lineasCompra LineaCompra[]

  @@index([negocioId])
  @@index([loteId])
  @@index([productoFuenteId])
  @@index([varianteBaseId])
  @@map("productos")
}

// Plantillas de capacidad de dispositivo (pod/mod/tanque): NO son productos que se venden,
// son perfiles reutilizables para calcular cuántos ml se lleva un cliente en una recarga sin
// tener que escribir el número cada vez. Editables por negocio — el dueño puede sumar/ajustar
// sus propios perfiles, no quedan fijos en el código.
model PerfilDispositivo {
  id          String   @id @default(cuid())
  negocioId   String   @map("negocio_id")
  negocio     Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  nombre      String   @db.VarChar(80)
  capacidadMl Decimal  @map("capacidad_ml") @db.Decimal(8, 2)
  // Precio fijo sugerido para este tamaño (ej. "Pod Estándar siempre $2"), sin importar el
  // precio por ml del líquido elegido. Si es null, se sigue calculando proporcional al ml
  // (precioVenta/volumenMl × ml) como hasta ahora — en ambos casos el cajero lo puede editar
  // antes de cobrar.
  precio      Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([negocioId])
  @@map("perfiles_dispositivo")
}

model MovimientoStock {
  id         String   @id @default(cuid())
  productoId String   @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tipo       String   @db.VarChar(12) // entrada | salida | ajuste | venta
  cantidad   Decimal  @db.Decimal(12, 3) // positivo entra, negativo sale
  motivo     String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([productoId])
  @@map("movimientos_stock")
}

model SesionCaja {
  id           String    @id @default(cuid())
  negocioId    String    @map("negocio_id")
  negocio      Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  montoInicial Decimal   @map("monto_inicial") @db.Decimal(12, 2)
  montoFinal   Decimal?  @map("monto_final") @db.Decimal(12, 2)
  abiertaEn    DateTime  @default(now()) @map("abierta_en")
  cerradaEn    DateTime? @map("cerrada_en")
  estado       String    @default("abierta") @db.VarChar(10) // abierta | cerrada

  ventas Venta[]

  @@index([negocioId])
  @@map("sesiones_caja")
}

model Venta {
  id              String          @id @default(cuid())
  negocioId       String          @map("negocio_id")
  negocio         Negocio         @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  subtotal        Decimal         @default(0) @db.Decimal(12, 2)
  impuesto        Decimal         @default(0) @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  metodoPago      String          @default("efectivo") @map("metodo_pago") @db.VarChar(20)
  sesionCajaId    String?         @map("sesion_caja_id")
  sesionCaja      SesionCaja?     @relation(fields: [sesionCajaId], references: [id])
  // Cliente al que se le fía esta venta (obligatorio cuando metodoPago = "fiado").
  clienteId       String?         @map("cliente_id")
  cliente         ClienteNegocio? @relation(fields: [clienteId], references: [id])
  createdAt       DateTime        @default(now()) @map("created_at")
  // Anulación: la venta queda como registro histórico (no se borra) pero se marca inválida,
  // se revierte el stock y el saldo/puntos del cliente si tenía.
  anulada         Boolean         @default(false)
  anuladaEn       DateTime?       @map("anulada_en")
  motivoAnulacion String?         @map("motivo_anulacion") @db.VarChar(200)

  lineas LineaVenta[]

  @@index([negocioId])
  @@index([clienteId])
  @@map("ventas")
}

model LineaVenta {
  id         String    @id @default(cuid())
  ventaId    String    @map("venta_id")
  venta      Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId String?   @map("producto_id")
  producto   Producto? @relation(fields: [productoId], references: [id])
  nombre     String    @db.VarChar(150)
  cantidad   Decimal   @db.Decimal(12, 3)
  precioUnit Decimal   @map("precio_unit") @db.Decimal(12, 2)
  subtotal   Decimal   @db.Decimal(12, 2)

  @@map("lineas_venta")
}

// ============================================================
//  MÓDULO: PRÉSTAMOS (rubro prestamista / financiera)
// ============================================================
enum EstadoPrestamo {
  activo
  pagado
  cancelado
}

model Prestamo {
  id                 String         @id @default(cuid())
  negocioId          String         @map("negocio_id")
  negocio            Negocio        @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  deudorNombre       String         @map("deudor_nombre") @db.VarChar(120)
  deudorTelefono     String?        @map("deudor_telefono") @db.VarChar(20)
  capital            Decimal        @db.Decimal(12, 2)
  tasaInteresMensual Decimal        @map("tasa_interes_mensual") @db.Decimal(6, 3) // % mensual
  plazoCuotas        Int            @map("plazo_cuotas")
  frecuencia         String         @default("mensual") @db.VarChar(12) // semanal | quincenal | mensual
  fechaInicio        DateTime       @map("fecha_inicio")
  estado             EstadoPrestamo @default(activo)
  notas              String?        @db.Text
  createdAt          DateTime       @default(now()) @map("created_at")

  cuotas CuotaPrestamo[]

  @@index([negocioId])
  @@map("prestamos")
}

model CuotaPrestamo {
  id               String    @id @default(cuid())
  prestamoId       String    @map("prestamo_id")
  prestamo         Prestamo  @relation(fields: [prestamoId], references: [id], onDelete: Cascade)
  numero           Int
  fechaVencimiento DateTime  @map("fecha_vencimiento")
  monto            Decimal   @db.Decimal(12, 2) // cuota total (capital + interés)
  capital          Decimal   @db.Decimal(12, 2)
  interes          Decimal   @db.Decimal(12, 2)
  montoPagado      Decimal   @default(0) @map("monto_pagado") @db.Decimal(12, 2)
  pagada           Boolean   @default(false)
  fechaPago        DateTime? @map("fecha_pago")

  @@unique([prestamoId, numero])
  @@index([prestamoId])
  @@map("cuotas_prestamo")
}

// Link de invitación único para que un peluquero se una a un negocio sin buscarlo.
model InvitacionNegocio {
  id                Int       @id @default(autoincrement())
  negocioId         String    @map("negocio_id")
  token             String    @unique @db.VarChar(64)
  expiraEn          DateTime  @map("expira_en")
  usadaPor          Int?      @map("usada_por") // usuarioId del peluquero que la usó
  usadaEn           DateTime? @map("usada_en")
  createdAt         DateTime  @default(now()) @map("created_at")
  // Si se define, al aceptar la invitación el usuario entra como miembro del negocio con
  // esta etiqueta de plantilla y estos permisos granulares, en vez de como peluquero.
  rolAsignado       String?   @map("rol_asignado") @db.VarChar(20)
  permisosAsignados String[]  @default([]) @map("permisos_asignados")

  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([negocioId])
  @@map("invitaciones_negocio")
}

// Token para restablecer contraseña (se envía por email; aquí se registra en consola).
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  token     String   @unique @db.VarChar(64)
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model PeluqueroEquipo {
  id               Int              @id @default(autoincrement())
  negocioId        String           @map("negocio_id")
  usuarioId        Int              @map("usuario_id")
  estadoAprobacion EstadoAprobacion @default(pendiente) @map("estado_aprobacion")
  createdAt        DateTime         @default(now()) @map("created_at")

  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([negocioId, usuarioId], name: "unique_peluquero_negocio")
  @@index([negocioId, estadoAprobacion])
  @@map("peluqueros_equipos")
}

// Personal del negocio con un rol FUNCIONAL (no confundir con PeluqueroEquipo, que es
// específico del módulo de citas). Un mismo usuario puede ser miembro de varios negocios
// con roles distintos en cada uno. El rol determina qué secciones puede usar en el panel.
model MiembroNegocio {
  id        String   @id @default(cuid())
  negocioId String   @map("negocio_id")
  usuarioId Int      @map("usuario_id")
  // Etiqueta de plantilla (gerente/cajero/inventario/contador/personalizado) — solo para
  // mostrar un nombre corto en la UI. El acceso real lo decide `permisos`, no este campo.
  rol       String   @default("cajero") @db.VarChar(20)
  // Permisos granulares concedidos a este miembro (ver Permiso en lib/acceso.ts): cada función
  // del sistema (vender, crear cliente, eliminar compra...) se otorga por separado.
  permisos  String[] @default([])
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([negocioId, usuarioId])
  @@index([negocioId, activo])
  @@map("miembros_negocio")
}

model Servicio {
  id              Int      @id @default(autoincrement())
  peluqueroId     Int      @map("peluquero_id")
  nombreServicio  String   @map("nombre_servicio") @db.VarChar(100)
  precio          Decimal  @db.Decimal(10, 2)
  moneda          String   @default("USD") @db.VarChar(3)
  duracionMinutos Int      @map("duracion_minutos")
  imagenUrl       String?  @map("imagen_url") @db.VarChar(255)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  peluquero     Usuario       @relation(fields: [peluqueroId], references: [id], onDelete: Cascade)
  reservaciones Reservacion[]

  @@index([peluqueroId])
  @@map("servicios")
}

// Disponibilidad horaria individual por peluquero (rangos por día de la semana)
model Disponibilidad {
  id          Int       @id @default(autoincrement())
  peluqueroId Int       @map("peluquero_id")
  dia         DiaSemana
  horaInicio  String    @map("hora_inicio") @db.VarChar(5) // "HH:MM"
  horaFin     String    @map("hora_fin") @db.VarChar(5) // "HH:MM"

  peluquero Usuario @relation(fields: [peluqueroId], references: [id], onDelete: Cascade)

  @@index([peluqueroId, dia])
  @@map("disponibilidades")
}

model Reservacion {
  id                    Int        @id @default(autoincrement())
  clienteId             Int        @map("cliente_id")
  peluqueroId           Int        @map("peluquero_id")
  servicioId            Int        @map("servicio_id")
  fecha                 DateTime   @db.Date
  horaInicio            String     @map("hora_inicio") @db.VarChar(5) // "HH:MM"
  horaFin               String     @map("hora_fin") @db.VarChar(5) // "HH:MM"
  pagoReservaStatus     EstadoPago @default(pendiente) @map("pago_reserva_status")
  estadoCita            EstadoCita @default(confirmada) @map("estado_cita")
  idTransaccionPasarela String?    @map("id_transaccion_pasarela") @db.VarChar(255)
  idReembolsoPasarela   String?    @map("id_reembolso_pasarela") @db.VarChar(255)
  // Token corto aleatorio para validar la cita en el local (NO usar el id secuencial)
  codigoValidacion      String     @unique @map("codigo_validacion") @db.VarChar(12)
  // Vencimiento del hold del slot si el pago no se confirma (lo libera el job de expiración).
  expiraPagoEn          DateTime?  @map("expira_pago_en")
  // Marca de recordatorio enviado (evita duplicados del job de recordatorios).
  recordatorioEnviadoEn DateTime?  @map("recordatorio_enviado_en")
  createdAt             DateTime   @default(now()) @map("created_at")

  cliente   Usuario  @relation("ClienteReserva", fields: [clienteId], references: [id])
  peluquero Usuario  @relation("PeluqueroReserva", fields: [peluqueroId], references: [id])
  servicio  Servicio @relation(fields: [servicioId], references: [id])
  resena    Resena?

  @@index([peluqueroId, fecha, estadoCita])
  @@index([pagoReservaStatus, expiraPagoEn])
  @@map("reservaciones")
}

// Bloqueo de agenda del profesional (descanso, vacaciones, ausencia).
// Si horaInicio/horaFin son null, bloquea todo el día.
model Bloqueo {
  id          Int      @id @default(autoincrement())
  peluqueroId Int      @map("peluquero_id")
  fecha       DateTime @db.Date
  horaInicio  String?  @map("hora_inicio") @db.VarChar(5)
  horaFin     String?  @map("hora_fin") @db.VarChar(5)
  motivo      String?  @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("created_at")

  peluquero Usuario @relation(fields: [peluqueroId], references: [id], onDelete: Cascade)

  @@index([peluqueroId, fecha])
  @@map("bloqueos")
}

// Reseña de una reserva completada (1 por reserva).
model Resena {
  id            Int      @id @default(autoincrement())
  reservacionId Int      @unique @map("reservacion_id")
  clienteId     Int      @map("cliente_id")
  peluqueroId   Int      @map("peluquero_id")
  negocioId     String   @map("negocio_id")
  puntuacion    Int // 1..5
  comentario    String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")

  reservacion Reservacion @relation(fields: [reservacionId], references: [id], onDelete: Cascade)
  cliente     Usuario     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  negocio     Negocio     @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([peluqueroId])
  @@index([negocioId])
  @@map("resenas")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  token     String   @unique @db.VarChar(64)
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  token     String   @unique @db.VarChar(128)
  expiraEn  DateTime @map("expira_en")
  revocado  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

// Registro de auditoría para acciones sensibles (baneos, cambios de suscripción, reembolsos).
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?     @map("actor_id") // usuario que ejecutó la acción
  accion    String   @db.VarChar(80)
  detalle   String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([accion])
  @@map("audit_logs")
}

// Licencia de la app de escritorio (Electron + Postgres embebido). Se compra/genera acá en
// el backend de la nube y se activa una sola vez desde la PC del cliente: esta tabla guarda
// el estado de esa activación, no las credenciales de uso diario (esas viven 100% locales en
// cada instalación, en la base embebida de cada negocio).
model Licencia {
  id             String    @id @default(cuid())
  clave          String    @unique @db.VarChar(40)
  plan           String    @default("basico") @db.VarChar(20) // basico | pro | vitalicio
  // Null = sin vencimiento (plan vitalicio, pago único). Con fecha = plan por suscripción.
  vencimiento    DateTime?
  // Funciones extra compradas aparte, solo desbloqueadas para ESTA licencia (no globales).
  funcionesExtra String[]  @default([]) @map("funciones_extra")
  // Huella de la instalación que activó la licencia (no es hardware real, ver electron/main.js).
  // Null = todavía sin activar.
  huellaMaquina  String?   @map("huella_maquina") @db.VarChar(100)
  activadaEn     DateTime? @map("activada_en")
  revocada       Boolean   @default(false)
  negocioId      String?   @map("negocio_id") // negocio (cuenta de la nube) que la compró, si aplica
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([clave])
  @@map("licencias")
}
