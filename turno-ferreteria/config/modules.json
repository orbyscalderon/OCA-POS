{
  "$comment": "Registro maestro de módulos. Un manifiesto de rubro enciende o apaga módulos de esta lista; el backend registra sus rutas y el frontend sus pantallas SOLO si están encendidos. `origin` indica de qué proyecto existente sale el código.",
  "version": 1,

  "origins": {
    "turno":     { "name": "Turno",                  "stack": "Express + TS + Prisma + React/Vite", "status": "en producción, no lanzado" },
    "oc-credit": { "name": "OC Credit",              "stack": "NestJS + TypeORM + React",           "status": "requiere port a Express" },
    "silvia":    { "name": "Supermercado Silvia",    "stack": "Next.js 14 + Prisma + NextAuth",     "status": "requiere port a Vite" },
    "marinero":  { "name": "Supermercado Marinero",  "stack": "Firebase / Firestore",               "status": "backend descartado" },
    "nuevo":     { "name": "Por construir",          "stack": "—",                                  "status": "no existe" }
  },

  "platform": {
    "$comment": "Infraestructura que NO se enciende por rubro: siempre está. Todo esto ya existe en Turno y es lo que más tiempo ahorra.",
    "auth":      { "origin": "turno", "provides": ["JWT + refresh rotativo", "bcrypt", "verificación de email", "reset de contraseña", "Google OAuth"], "files": "backend/src/lib/auth.ts, lib/refresh.ts, modules/auth.routes.ts" },
    "rbac":      { "origin": "turno", "provides": ["guards por rol", "middleware de autorización"], "files": "backend/src/middleware/auth.ts", "adapt": "extender de 4 roles fijos a los roles del manifiesto + 140 permisos" },
    "tenancy":   { "origin": "nuevo", "provides": ["resolución de tenant", "SET LOCAL app.tenant_id", "transacción con RLS"], "adapt": "Turno es multi-tenant por filtro en query; hay que moverlo a RLS de PostgreSQL" },
    "audit":     { "origin": "turno", "provides": ["registro de acciones"], "files": "backend/src/lib/audit.ts", "adapt": "encadenar por hash SHA-256 contra app.audit_logs" },
    "jobs":      { "origin": "turno", "provides": ["cron de expiración", "recordatorios"], "files": "backend/src/jobs/" },
    "payments":  { "origin": "turno", "provides": ["abstracción PaymentProvider", "Stripe", "Stripe Connect"], "files": "backend/src/modules/pagos.provider.ts, connect.routes.ts" },
    "messaging": { "origin": "turno", "provides": ["WhatsApp deep link", "email SMTP"], "files": "backend/src/lib/whatsapp.ts, lib/email.ts", "adapt": "pasar de deep link a WhatsApp Business API con plantillas" },
    "storage":   { "origin": "turno", "provides": ["S3 / Backblaze B2 + CDN Cloudflare"], "files": "backend/src/lib/storage.ts" },
    "billing":   { "origin": "turno", "provides": ["planes", "límites por plan", "suscripción"], "files": "backend/src/lib/planes.ts, modules/suscripcion.routes.ts", "adapt": "mapear a platform.plans y platform.subscriptions" },
    "superadmin":{ "origin": "turno", "provides": ["panel de plataforma"], "files": "backend/src/modules/superadmin.routes.ts, frontend/src/components/SuperadminView.tsx" },
    "i18n":      { "origin": "turno", "provides": ["es / en"], "files": "frontend/src/i18n.tsx" },
    "landing":   { "origin": "turno", "provides": ["landing pública", "precios", "legal", "cookies"], "files": "frontend/src/components/PublicLanding.tsx, Precios.tsx, Legal.tsx, CookieConsent.tsx" },
    "testing":   { "origin": "turno", "provides": ["Vitest", "Playwright e2e"], "files": "backend/tests/, frontend/e2e/" },
    "deploy":    { "origin": "turno", "provides": ["Railway + Supabase + Cloudflare Pages + Backblaze B2", "Dockerfiles", "nginx.conf"], "files": "DEPLOY-RAILWAY-SUPABASE-CLOUDFLARE.md, GO-LIVE.md" }
  },

  "modules": {
    "pos": {
      "name": "Punto de venta", "core": true, "origin": "silvia",
      "reuse": ["caja con lector de barras", "búsqueda de productos", "registro de venta"],
      "files": "src/app/api/caja/{barcode,productos,venta}, src/app/admin",
      "build": ["layouts por rubro (grid/peso/servicio/búsqueda/mesas)", "impresión ESC/POS", "modo offline con RxDB", "múltiples métodos de pago"],
      "tables": ["sales", "sale_lines", "sale_payments", "sale_returns", "promotions"]
    },
    "credit": {
      "name": "Fiado y cuentas por cobrar", "core": true, "origin": "oc-credit",
      "reuse": ["plan de amortización", "cargos por mora", "registro de cobros", "transacciones"],
      "files": "backend/src/modules/{prestamos,cobros}, helpers/amortizacion.helper.ts",
      "build": ["libreta de fiado sin cronograma", "cobranza por WhatsApp con link de pago"],
      "tables": ["credit_accounts", "credit_installments", "credit_movements", "payment_links"]
    },
    "customers": {
      "name": "Clientes", "core": true, "origin": "oc-credit",
      "reuse": ["base de clientes con coordenadas GPS"],
      "files": "backend/src/modules/clientes",
      "build": ["atributos dinámicos por rubro"],
      "tables": ["customers"]
    },
    "cash": {
      "name": "Caja y arqueo", "core": true, "origin": "oc-credit",
      "reuse": ["apertura y cierre de caja", "transacciones de caja"],
      "files": "backend/src/modules/cajas",
      "build": ["arqueo por denominación", "detección de descuadre auditada"],
      "tables": ["cash_sessions", "cash_movements", "cash_count_lines"]
    },
    "inventory": {
      "name": "Inventario", "core": false, "origin": "silvia",
      "reuse": ["catálogo de productos y categorías", "admin de productos"],
      "files": "prisma/schema.prisma (Product, Category), src/app/admin/products",
      "build": ["ledger conmutativo de stock", "costo promedio ponderado", "lotes y vencimiento", "multi-almacén", "unidades multidimensionales"],
      "tables": ["products", "product_variants", "stock_events", "stock_balances", "variant_costs"]
    },
    "purchasing":     { "name": "Compras y proveedores", "core": false, "origin": "nuevo", "build": ["órdenes de compra", "recepciones", "CXP", "reabastecimiento predictivo"], "tables": ["suppliers", "purchase_orders", "supplier_bills"] },
    "expenses":       { "name": "Gastos operativos",     "core": true,  "origin": "nuevo", "build": ["caja chica", "gastos recurrentes", "centro de costo"], "tables": ["expenses", "expense_categories"] },
    "taxes":          { "name": "Impuestos y comprobantes", "core": true, "origin": "nuevo", "build": ["motor de impuestos por país", "folios en bloques por dispositivo", "facturación electrónica DGII"], "tables": ["taxes", "fiscal_documents", "fiscal_sequences"] },
    "employees": {
      "name": "Equipo", "core": false, "origin": "turno",
      "reuse": ["invitaciones al equipo", "límite de miembros por plan", "vista por rol"],
      "files": "backend/src/modules/negocios.routes.ts (PeluqueroEquipo, InvitacionNegocio)",
      "build": ["marcaje de asistencia", "comisiones por venta"],
      "tables": ["employees", "time_entries", "employee_commissions"]
    },
    "appointments": {
      "name": "Citas y agenda", "core": false, "origin": "turno",
      "reuse": ["★ motor de slots", "anti-colisión con SELECT FOR UPDATE", "disponibilidad por profesional", "bloqueos", "reservas", "reseñas", "recordatorios"],
      "files": "backend/src/modules/{slots.service,disponibilidad,reservas,resenas}.ts, frontend/src/components/{ClienteView,PeluqueroView,AdminView}.tsx",
      "build": ["reemplazar el lock por la restricción EXCLUDE de PostgreSQL, que ya está en el esquema"],
      "tables": ["appointments", "resources", "service_orders"]
    },
    "storefront": {
      "name": "Tienda online", "core": false, "origin": "silvia",
      "reuse": ["★ carrito", "checkout", "detalle de pedido", "devoluciones", "páginas legales"],
      "files": "src/app/(store)/{cart,checkout,order,devoluciones}",
      "build": ["catálogo por tenant sincronizado con inventario", "pedido por WhatsApp", "zonas de entrega"],
      "tables": ["storefronts", "online_orders", "delivery_zones"]
    },
    "lending": {
      "name": "Préstamos", "core": false, "origin": "oc-credit",
      "reuse": ["★ rutas de cobranza con GPS", "novedades de ruta", "webhooks de pagos digitales", "feriados", "amortización francesa"],
      "files": "backend/src/modules/{rutas,prestamos,cobros}",
      "build": ["integrar al ledger de crédito unificado"],
      "tables": ["credit_accounts (kind=loan)", "credit_installments"]
    },
    "loyalty":        { "name": "Fidelización",  "core": false, "origin": "nuevo", "build": ["puntos", "cashback", "sellos", "campañas"], "tables": ["loyalty_programs", "loyalty_accounts", "loyalty_movements"] },
    "tables":         { "name": "Mesas y comandas", "core": false, "origin": "nuevo", "build": ["plano de salón", "comandas por estación", "cuentas divididas"], "tables": ["tables", "table_orders", "table_order_items"] },
    "service_orders": { "name": "Órdenes de servicio", "core": false, "origin": "nuevo", "build": ["recepción con fotos", "diagnóstico", "cotización", "garantía"], "tables": ["service_orders", "service_order_lines"] },
    "agro": {
      "name": "Módulo agropecuario", "core": false, "origin": "nuevo",
      "build": ["lotes biológicos", "mortalidad diaria", "conversión alimenticia", "faena y costeo por kg"],
      "tables": ["biological_lots", "biological_events", "biological_costs", "harvests", "farm_units"],
      "note": "Sin precedente en los proyectos existentes. Es el diferenciador que ningún competidor tiene."
    }
  }
}
