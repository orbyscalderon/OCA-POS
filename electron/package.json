{
  "name": "ocapos-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OCA POS - app de escritorio (Electron + Postgres embebido)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ocapos.desktop",
    "productName": "OCA POS",
    "directories": { "output": "release" },
    "files": ["main.js", "licencia.js", "activation.html", "preload-activation.js", "backend-dist/**", "frontend-dist/**", "node_modules/**"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
